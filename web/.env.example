# Unseen BD web app: every environment variable it reads.
#
# Local development: copy to `.env.local`. Production: copy to `.env.production.local` on the
# server (chmod 600, owned by the app user). Never commit real values; `.env*` is gitignored
# except this file. `npm start` (server.mjs), `next build` and the `db:*` / `admin:create`
# scripts all load these files; variables already set in the environment (pm2, systemd) win.
# Lines starting with `#` are optional and show the default.

# --- Site -------------------------------------------------------------------------------------

# Public origin of the site, used for canonical, hreflang, sitemap and share URLs. Read at BUILD
# time too (prerendered pages), so set it before `npm run build`.
SITE_URL=https://unseenbd.com

# The Facebook page linked in the header and footer. Inlined at build time.
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/

# --- Server (npm start → server.mjs) ------------------------------------------------------------

# Port to listen on.
# PORT=3000

# Interface to bind. Empty = every interface. Behind nginx set 127.0.0.1, so the app can only be
# reached through nginx (the rate limits trust nginx's X-Real-IP header).
# LISTEN_HOST=127.0.0.1

# `npm start` sets NODE_ENV=production itself; set it explicitly when starting server.mjs directly.
# NODE_ENV=production

# Structured JSON logs on stdout/stderr: debug | info | warn | error. Static files log at debug.
# LOG_LEVEL=info

# On SIGTERM/SIGINT, how long requests in flight may take to finish before the process exits.
# Keep pm2's kill_timeout a little above it.
# SHUTDOWN_TIMEOUT_MS=10000

# --- Storage (relative to web/ or absolute) ----------------------------------------------------

# SQLite database file. Back it up (see DEPLOY.md: sqlite3 .backup, not cp, while running).
# DATABASE_PATH=data/unseenbd.sqlite

# Uploaded community photos and post/listing photos, served from /media/… with a one-year cache.
# Back this directory up together with the database.
# MEDIA_DIR=storage/media

# Real place photos from Wikimedia Commons (`npm run photos`), served from /photos/….
# PHOTOS_DIR=storage/photos

# Where the seed reads its data and the asset sync its files (the repository's data/ and assets/).
# SEED_DATA_DIR=../data
# ASSETS_DIR=../assets

# Drizzle migrations.
# MIGRATIONS_DIR=drizzle

# --- Accounts -----------------------------------------------------------------------------------

# Required everywhere except `next dev` and the tests: at least 32 random characters. Keys the HMAC
# under which session tokens, device ids and IP hashes are stored, so a copy of the database alone
# cannot sign anyone in. Changing it signs everybody out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# OAuth 2.0 web client id from Google Cloud Console (APIs & Services → Credentials), for
# "Sign in with Google" (Google Identity Services). Add the site's origin, e.g.
# https://unseenbd.com, to the client's "Authorised JavaScript origins". Leave empty to hide the
# Google button; email + password sign-in works either way.
GOOGLE_CLIENT_ID=

# The session cookie is `Secure` in production and not in development. Set 1 or 0 to force it,
# e.g. COOKIE_SECURE=0 to try a production build over plain http://localhost.
# COOKIE_SECURE=

# Salt for the hashed IPs kept with leaderboard entries. Set any long random string.
# IP_HASH_SALT=

# --- First admin (npm run admin:create) --------------------------------------------------------

# Used only by `npm run admin:create`; it asks in the terminal for anything missing. Do not leave
# ADMIN_PASSWORD in a file on the server.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
