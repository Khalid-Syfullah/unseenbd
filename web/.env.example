# Unseen BD web app — environment variables. Copy to `.env.local` (never commit real values).

# Public origin of the site, used for canonical, hreflang and share URLs.
SITE_URL=https://unseenbd.com

# SQLite database file (relative to web/). Defaults to data/unseenbd.sqlite.
# DATABASE_PATH=data/unseenbd.sqlite

# --- Accounts ---------------------------------------------------------------------------------

# Required in production: at least 32 random characters. Keys the HMAC under which session
# tokens are stored, so a copy of the database alone cannot sign anyone in. Changing it signs
# everybody out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# OAuth 2.0 web client id from Google Cloud Console (APIs & Services → Credentials), for
# "Sign in with Google" (Google Identity Services). Add the site's origin, e.g.
# https://unseenbd.com, to the client's "Authorised JavaScript origins". Leave empty to hide the
# Google button; email + password sign-in works either way.
GOOGLE_CLIENT_ID=

# The session cookie is `Secure` in production and not in development. Set 1 or 0 to force it,
# e.g. COOKIE_SECURE=0 to try a production build over plain http://localhost.
# COOKIE_SECURE=
